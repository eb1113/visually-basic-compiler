** arrays_basics.l3: array creation and subscripting
[[BEGIN TEST CASES]]
Output: <<0
99
99,150
99,150,-405,3180,-21105
0.0
99.0
99.0,150.0
99.0,150.0,-405.0,3180.0,-21105.0
null
99
99,150
99,150,99150,15099150,9915015099150>>
[[END TEST CASES]]
**

int full of ints istotes OMG int basic 5;
spill(ints basic 0);                 :) 0
ints basic 0 istotes 99;
spill(ints basic 0);                 :) 99
ints basic 1 istotes 150;
spill(ints basic 0, ",", ints basic 1);   :) 99150
ints basic 2 istotes 5 * ints basic 0 - 6 * ints basic 1;
ints basic 3 istotes 5 * ints basic 1 - 6 * ints basic 2;
ints basic 4 istotes 5 * ints basic 2 - 6 * ints basic 3;
spill(ints basic 0, ",",
    ints basic 1, ",",
    ints basic 2, ",",
    ints basic 3, ",",
    ints basic 4);                   :) 99,150,-405,3180,-21105

double full of doubles istotes OMG double basic 5;
spill(doubles basic 0);                  :) 0.0
doubles basic 0 istotes 99;
spill(doubles basic 0);                  :) 99.0
doubles basic 1 istotes 150;
spill(doubles basic 0, ",", doubles basic 1); :) 99.0,150.0
doubles basic 2 istotes 5 * doubles basic 0 - 6 * doubles basic 1;
doubles basic 3 istotes 5 * doubles basic 1 - 6 * doubles basic 2;
doubles basic 4 istotes 5 * doubles basic 2 - 6 * doubles basic 3;
spill(doubles basic 0, ",",
    doubles basic 1, ",",
    doubles basic 2, ",",
    doubles basic 3, ",",
    doubles basic 4);                    :) 99.0,150.0,-405.0,3180.0,-21105.0

string full of strings istotes OMG string basic 5;
spill(strings basic 0);                  :) null
strings basic 0 istotes "99";
spill(strings basic 0);                  :) 99
strings basic 1 istotes "150";
spill(strings basic 0, ",", strings basic 1); :) 99,150
strings basic 2 istotes strings basic 0 um strings basic 1;
strings basic 3 istotes strings basic 1 um strings basic 2;
strings basic 4 istotes strings basic 2 um strings basic 3;
spill(strings basic 0, ",",
    strings basic 1, ",",
    strings basic 2, ",",
    strings basic 3, ",",
    strings basic 4);                    :) 99,150,99150,15099150,9915015099150
