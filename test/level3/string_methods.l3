/* string_methods.l3: test builtin string methods
[[BEGIN TEST CASES]]
Output: <<26
4
-1
IJKLM>>
[[END TEST CASES]]
*/

string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
print(alphabet.length());           // 26
print(alphabet.indexOf("E"));       // 4
print(alphabet.indexOf("!"));       // -1
print(alphabet.substring(8, 13));   // IJKLM
