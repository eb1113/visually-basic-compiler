** string_methods.l3: test builtin string methods
[[BEGIN TEST CASES]]
Output: <<26
4
-1
IJKLM>>
[[END TEST CASES]]
**

string alphabet istotes "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
spill(alphabet XO length());           :) 26
spill(alphabet XO indexOf("E"));       :) 4
spill(alphabet XO indexOf("!"));       :) -1
spill(alphabet XO substring(8, 13));   :) IJKLM
