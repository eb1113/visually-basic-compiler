record Data(double[] data, int count) {

    void add(double d) {
        if (count == data.length) {
            double[] data2 = new double[data.length * 2];
            for (int i = 0; i < data.length; i++)
                data2[i] = data[i];
            this.data = data2;
        }

        data[count++] = d;
    }

    double sum() {
        double sum = 0;
        for (int i = 0; i < count; i++)
            sum = sum + data[i];
        return sum;
    }

    double average() {
        return sum() / count;
    }

    void clear() {
        count = 0;
    }

    string toString() {
        string s = "[";
        for (int i = 0; i < count; i++) {
            s = s + data[i];
            if (i + 1 < count)
                s = s + ",";
        }
        s = s + "]";
        return s;
    }
}

Data makeData() {
    return new Data(new double[3], 0);
}

Data data = makeData();
boolean continue = true;
while (continue) {
    double n = input("Enter a number (or -1 to stop): ");
    if (n >= 0)
        data.add(n);
    else
        continue = false;
}

print("You entered ", data.count, " numbers:");
print(data);
print("Their sum is ", data.sum(), ".");
print("Their average is ", data.average(), ".");
print("The array capacity is ", data.data.length, ".");
