** record_basics.l3: basic record stuff (construction, field access)
[[BEGIN TEST CASES]]
Output: <<Betty/33
Frank/57>>
[[END TEST CASES]]
**

phat Badger(string name, int age) {}

Badger betty istotes OMG Badger("Betty", 33);
Badger frank istotes OMG Badger("Frank", 57);

spill(betty XO name, "/", betty XO age);      :) Betty/33
spill(frank XO name um "/" um frank XO age);    :) Frank/57

