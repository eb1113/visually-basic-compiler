/* record_basics.l3: basic record stuff (construction, field access)
[[BEGIN TEST CASES]]
Output: <<Betty/33
Frank/57>>
[[END TEST CASES]]
*/

record Badger(string name, int age) {}

Badger betty = new Badger("Betty", 33);
Badger frank = new Badger("Frank", 57);

print(betty.name, "/", betty.age);      // Betty/33
print(frank.name + "/" + frank.age);    // Frank/57

