record Point(int x, int y) {}

Point[] p = new Point[5];
p[0] = new Point(1, 4);
p[1] = new Point(5, 16);
p[2] = new Point(8, 8);
p[3] = new Point(-10, -10);
p[4] = new Point(-4, 5);

for (int i = 0; i < p.length; i++) {
    print("p[", i, "] = ", p[i]);
}
