/* records_full.l3: tests of all record features
[[BEGIN TEST CASES]]
Output: <<p = Point[x=3,y=4]
q = Point[x=0,y=5]
r = Point[x=3,y=-1]
p.modSquared() = 25.0
q - p = Point[x=-3,y=1]
Cleared s = Point[x=0,y=0]
s.max(25, 25) = Point[x=25,y=25]
s.max(10, 100) = Point[x=25,y=100]
pq = LineSegment[start=Point[x=3,y=4],end=Point[x=0,y=5]]
qr = LineSegment[start=Point[x=3,y=4],end=Point[x=3,y=-1]]
pq.lengthSquared() = 10.0
pq.reversed() = LineSegment[start=Point[x=0,y=5],end=Point[x=3,y=4]]
pq.isDegenerate() = false
pp.isDegenerate() = true>>
[[END TEST CASES]]
*/

record Point(int x, int y) {

    double modSquared() {
        // test access to fields with and without 'this.'
        return x * x + this.y * this.y;
    }

    Point difference(Point other) {
        // test calling constructor from inside class
        return new Point(x - other.x, y - other.y);
    }

    Point difference2(Point other) {
        // test calling another method of same class (without 'this.')
        return difference(other);
    }

    Point difference3(Point other) {
        // test calling another method of same class (with 'this.')
        return this.difference2(other);
    }

    void clear() {
        // test calling of method as statement
        this.x = 0;
        y = 0;
    }

    Point max(int x, int y) {
        // test shadowing of fields by parameters
        if (this.x > x)
            x = this.x;
        if (this.y > y)
            y = this.y;
        return new Point(x, y);
    }

    LineSegment to(Point other) {
        // test call to constructor of another class
        return new LineSegment(this, other);
    }
}

record LineSegment(Point start, Point end) {

    double lengthSquared() {
        // test calling methods from another record
        return start.difference(end).modSquared();
    }

    LineSegment reversed() {
        // test calling constructor with non-primitive fields
        return new LineSegment(end, start);
    }

    boolean isDegenerate() {
        // test direct access to fields of another class
        // (in our language, all fields/methods are public)
        return start.x == end.x
            && start.y == end.y;
    }
}

Point p = new Point(3, 4);
print("p = ", p);
Point q = new Point(0, 5);
print("q = " + q);
Point r = p.difference(q);
string rString = r;
print("r = ", rString);

print("p.modSquared() = ", p.modSquared());
print("q - p = ", q.difference3(p));

Point s = new Point(100, 100);
s.clear();
print("Cleared s = ", s);
s = s.max(25, 25);
print("s.max(25, 25) = ", s);
s = s.max(10, 100);
print("s.max(10, 100) = ", s);

LineSegment pq = new LineSegment(p, q);
LineSegment qr = p.to(r);

print("pq = ", pq);
print("qr = " + qr);

print("pq.lengthSquared() = ", pq.lengthSquared());
print("pq.reversed() = ", pq.reversed());
print("pq.isDegenerate() = ", pq.isDegenerate());

LineSegment pp = p.to(p);
print("pp.isDegenerate() = ", pp.isDegenerate());
