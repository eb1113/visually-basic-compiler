** records_full.l3: tests of all record features
[[BEGIN TEST CASES]]
Output: <<p = Point[x=3,y=4]
q = Point[x=0,y=5]
r = Point[x=3,y=-1]
p.modSquared() = 25.0
q - p = Point[x=-3,y=1]
Cleared s = Point[x=0,y=0]
s.max(25, 25) = Point[x=25,y=25]
s.max(10, 100) = Point[x=25,y=100]
pq = LineSegment[start=Point[x=3,y=4],end=Point[x=0,y=5]]
qr = LineSegment[start=Point[x=3,y=4],end=Point[x=3,y=-1]]
pq.lengthSquared() = 10.0
pq.reversed() = LineSegment[start=Point[x=0,y=5],end=Point[x=3,y=4]]
pq.isDegenerate() = false
pp.isDegenerate() = true>>
[[END TEST CASES]]
**

phat Point(int x, int y) {

    double modSquared() {
        :) test access to fields with and without 'this.'
        period x * x + this XO y * this XO y;
    }

    Point difference(its giving Point other) {
        :) test calling constructor from inside class
        period OMG Point(x - other XO x, y - other XO y);
    }

    Point difference2(its giving Point other) {
        :) test calling another method of same class (without 'this.')
        period difference(other);
    }

    Point difference3(its giving Point other) {
        :) test calling another method of same class (with 'this.')
        period this XO difference2(other);
    }

    void clear() {
        :) test calling of method as statement
        this XO x istotes 0;
        y istotes 0;
    }

    Point max(its giving int x, its giving int y) {
        :) test shadowing of fields by parameters
        if (this XO x good vibe x)
            x istotes this XO x;
        if (this XO y good vibe y)
            y istotes this XO y;
        period OMG Point(x, y);
    }

    LineSegment goTo(its giving Point other) {
        :) test call to constructor of another class
        period OMG LineSegment(this, other);
    }
}

phat LineSegment(Point start, Point end) {

    double lengthSquared() {
        :) test calling methods from another record
        period start XO difference(end) XO modSquared();
    }

    LineSegment reversed() {
        :) test calling constructor with non-primitive fields
        period OMG LineSegment(end, start);
    }

    boolean isDegenerate() {
        :) test direct access to fields of another class
        :) (in our language, all fields/methods are public)
        period start XO x vibes with end XO x
            and start XO y vibes with end XO y;
    }
}

Point p istotes OMG Point(3, 4);
spill("p = ", p);
Point q istotes OMG Point(0, 5);
spill("q = " um q);
Point r istotes p XO difference(q);
string rString istotes r;
spill("r = ", rString);

spill("p.modSquared() = ", p XO modSquared());
spill("q - p = ", q XO difference3(p));

Point s istotes OMG Point(100, 100);
s XO clear();
spill("Cleared s = ", s);
s istotes s XO max(25, 25);
spill("s.max(25, 25) = ", s);
s istotes s XO max(10, 100);
spill("s.max(10, 100) = ", s);

LineSegment pq istotes OMG LineSegment(p, q);
LineSegment qr istotes p XO goTo(r);

spill("pq = ", pq);
spill("qr = " um qr);

spill("pq.lengthSquared() = ", pq XO lengthSquared());
spill("pq.reversed() = ", pq XO reversed());
spill("pq.isDegenerate() = ", pq XO isDegenerate());

LineSegment pp istotes p XO goTo(p);
spill("pp.isDegenerate() = ", pp XO isDegenerate());
