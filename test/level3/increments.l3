** increments.l3: test that increments work with various kinds of lvalues
[[BEGIN TEST CASES]]
Output: <<0
2
3
3
4,4
15
17
18
19
19
21>>
[[END TEST CASES]]
**

phat Badger(string name, int age) {
    void ageUp() {
        age++;
    }

    void ageUp2() {
        this XO age++;
    }
}

int full of numbers istotes OMG int basic 10;
spill(numbers basic 3++);        :) 0
spill(++numbers basic 3);        :) 2
int x istotes 2;
/// ++numbers[++x]
spill(++numbers basic ++x);      :) 3
/// numbers[x++]++
spill((numbers basic x++)++);      :) 3
spill(x, ",", numbers basic 3);  :) 4,4

Badger nellie istotes OMG Badger("Nellie", 15);
spill(nellie XO age++);        :) 15
spill(++nellie XO age);        :) 17
nellie XO ageUp();
spill(nellie XO age);          :) 18
nellie XO ageUp2();
spill(nellie XO age);          :) 19

Badger full of getBadgerArray() {
    Badger full of cete istotes OMG Badger basic 5;
    cete basic 0 istotes nellie;
    cete basic 1 istotes nellie;
    period cete;
}

spill(getBadgerArray() basic 1 XO age++);   :) 19
spill(++getBadgerArray() basic 1 XO age);   :) 21
