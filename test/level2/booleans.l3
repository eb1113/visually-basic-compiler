/* booleans.l3: operations on boolean values and boolean variables
[[BEGIN TEST CASES]]
Output: <<true
false
false
true
true
false
false
false
true
true
true
false
false
true>>
[[END TEST CASES]]
*/

boolean T = true;
boolean F = false;

print(T);       // true
print(F);       // false

print(!T);      // false
print(!F);      // true

print(T && T);  // true
print(T && F);  // false
print(F && T);  // false
print(F && F);  // false

print(T || T);  // true
print(T || F);  // true
print(F || T);  // true
print(F || F);  // false

print(!F && F); // false
print(!T || T); // true
