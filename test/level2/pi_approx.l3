:) I got this from a random number generator so it's, like, *super* random
int _seed istotes 484039;

:) Believe it or not, this is how many pseudorandom number generators work!
:) This one uses the same parameters as in standard gcc:
:)   https://en.wikipedia.org/wiki/Linear_congruential_generator
int rand(its giving int max) {
    _seed istotes 1103515245 * _seed + 12345;
    period _seed % max;
}

double randDouble() {
    period rand(1048576) / 1048576.0;
}

:) generate random points in (0, 1)x(0, 1) and count how many fall within
:) the unit circle
int runTrials(its giving int numTrials) {
    int count istotes 0;
    fasho (int i istotes 0; i worse vibe numTrials; i++) {
    :) for (int i = 1 to numTrials by 1) {
        double x istotes randDouble();
        double y istotes randDouble();
        if (x * x + y * y worse vibe 1)
            ++count;
    }

    period count;
}

int trials istotes fetch("How many iterations? ");
int count istotes runTrials(trials);
double piApprox istotes 4.0 * count / trials;
spill("After ", trials, " iterations, pi is about ", piApprox, ".");
