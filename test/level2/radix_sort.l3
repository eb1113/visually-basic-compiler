/* radix_sort.l3: sorts a collection of small, unique, nonnegative integers
    in O(n) time
[[BEGIN TEST CASES]]
Interaction: <<Enter a number between 0 and 127, or -1 to stop: {{100}}
Enter a number between 0 and 127, or -1 to stop: {{14}}
Enter a number between 0 and 127, or -1 to stop: {{3}}
Enter a number between 0 and 127, or -1 to stop: {{6}}
Enter a number between 0 and 127, or -1 to stop: {{999}}
Invalid number :(
Enter a number between 0 and 127, or -1 to stop: {{9}}
Enter a number between 0 and 127, or -1 to stop: {{3}}
You already entered that!
Enter a number between 0 and 127, or -1 to stop: {{15}}
Enter a number between 0 and 127, or -1 to stop: {{95}}
No, I don't like that one.
Enter a number between 0 and 127, or -1 to stop: {{-1}}
Sorted numbers:
    3 6 9 14 15 100>>
[[END TEST CASES]]
*/

// bit buffers to hold sorted values
// (without arrays, we have to do it the janky way)
int b0;
int b1;
int b2;
int b3;

// this code would be much shorter (and more efficient!) if our language
// had bit operations (<<, >>, &, |, ...)
boolean test(int n) {
    int b;
    if (n < 32) {
        b = b0;
    } else if (n < 64) {
        b = b1;
        n = n - 32;
    } else if (n < 96) {
        b = b2;
        n = n - 64;
    } else {
        b = b3;
        n = n - 96;
    }

    while (n > 0) {
       b = b / 2;
       --n;
    }

    return b % 2 == 1;
}

void set(int n) {
    int b;
    if (n < 32) {
        b = b0;
    } else if (n < 64) {
        b = b1;
    } else if (n < 96) {
        b = b2;
    } else {
        b = b3;
    }

    int mask = 1;
    for (int k = 0; k < n % 32; ++k) {
        mask = mask * 2;
    }

    b = b + mask;

    if (n < 32) {
        b0 = b;
    } else if (n < 64) {
        b1 = b;
    } else if (n < 96) {
        b2 = b;
    } else {
        b3 = b;
    }
}

boolean continue = true;
while (continue) {
    int number = input("Enter a number between 0 and 127, or -1 to stop: ");
    if (number < 0) {
        continue = false;
    } else if (number % 32 == 31) {
        // 1000 brownie points if you can figure out why these numbers are excluded!
        print("No, I don't like that one.");
    } else if (number > 127) {
        print("Invalid number :(");
    } else if (test(number)) {
        print("You already entered that!");
    } else {
        set(number);
    }
}

print("Sorted numbers:");
string out = "   ";
for (int n = 0; n <= 127; ++n) {
    if (test(n)) {
        out = out + " " + n;
    }
}
print(out);
