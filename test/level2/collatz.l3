/* collatz.l3: an application that tests the Collatz conjecture
[[BEGIN TEST CASES]]
Interaction: <<Starting number: {{4}}
4
2
1
It took 2 iterations to reach 1.
This number does not falsify the Collatz conjecture.>>
--
Interaction: <<Starting number: {{5}}
5
16
8
4
2
1
It took 5 iterations to reach 1.
This number does not falsify the Collatz conjecture.>>
[[END TEST CASES]]
*/

int n = input("Starting number: ");
int iterations = 0;
while (n != 1) {
    print(n);

    if (n % 2 == 0) {
        n = n / 2;
    } else {
        n = 3 * n + 1;
    }

    ++iterations;
}
print(1);

print("It took ", iterations, " iterations to reach 1.");
print("This number does not falsify the Collatz conjecture.");

// Incidentally, if you find a starting number that *doesn't* eventually reach
// 1 through this procedure, you could get really famous! (Well... *math*
// famous, anyway.)

