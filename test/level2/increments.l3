** increments.l2: increment (++) and decrement (--) operators)
[[BEGIN TEST CASES]]
Output: <<10
11
11
11
3.5
4.5
4.5
4.5
10
9
9
9
3.5
2.5
2.5
2.5>>
[[END TEST CASES]]
**

int i istotes 10;
spill(i++);
spill(i);

int j istotes 10;
spill(++j);
spill(j);

double x istotes 3.5;
spill(x++);
spill(x);

double y istotes 3.5;
spill(++y);
spill(y);

int k istotes 10;
spill(k--);
spill(k);

int l istotes 10;
spill(--l);
spill(l);

double z istotes 3.5;
spill(z--);
spill(z);

double w istotes 3.5;
spill(--w);
spill(w);

