/* if.l3: if (not if-else) statements
[[BEGIN TEST CASES]]
Output: <<A
B
C
D
E
F
G1
G2
H1
H2
I
J
K
L
M
N
O
P
Q>>
[[END TEST CASES]]
*/

// (your program should print all the letters except for Xs)

if (true) {
    print("A");
}
print("B");

if (false) {
    print("X0");
}
print("C");

if (0 < 1) {
    print("D");
}
print("E");

if (0 > 1) {
    print("X1");
}
print("F");

int zero = 0;
int one = 1;
if (zero < one) {
    print("G1");
    print("G2");
}
print("H1");
print("H2");

if (zero < 1) {
    print("I");
}
print("J");

if (0 < one) {
    print("K");
}
print("L");

if (zero > 1) {
    print("X2");
}
print("M");

if (0 > one) {
    print("X3");
}
print("N");

if (zero < one && 0 < 1) {
    print("O");
}
print("P");

if (zero < one && 0 > 1) {
    print("X4");
}
print("Q");
