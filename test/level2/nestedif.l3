/* nestedif.l3: nested if (and if-else) statements
[[BEGIN TEST CASES]]
Output: <<A1
A2
B1
B2
C1
C2
D
E
F>>
[[END TEST CASES]]
*/

// (your program should print all the letters except for Xs)

if (true) {
    print("A1");
    print("A2");
    if (false) {
        print("X0");
    } else {
        print("B1");
        print("B2");
    }
    print("C1");
    print("C2");
} else {
    print("X1");
    if (false) {
        print("X2");
    } else {
        print("X3");
    }
    print("X4");
}

if (true) {
    print("D");
    if (true) {
        print("E");
        if (true) {
            print("F");
        }
    }
}
