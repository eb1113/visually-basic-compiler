/* ifelse.l3: if-else (not plain if) statements
[[BEGIN TEST CASES]]
Output: <<A1
A2
B1
B2
C
D1
D2
E1
E2>>
[[END TEST CASES]]
*/

// (your program should print all the letters except for Xs)

if (true) {
    print("A1");
    print("A2");
} else {
    print("X0");
}

if (false) {
    print("X11");
    print("X12");
} else {
    print("B1");
    print("B2");
}

if (true) {
    print("C");
} else if (true) {
    print("X2");
} else if (true) {
    print("X3");
} else {
    print("X4");
}

if (false) {
    print("X5");
} else if (false) {
    print("X6");
} else if (false) {
    print("X7");
} else if (true) {
    print("D1");
    print("D2");
} else {
    print("X8");
}

if (false) {
    print("X9");
} else if (false) {
    print("X10");
} else if (false) {
    print("X11");
} else {
    print("E1");
    print("E2");
}