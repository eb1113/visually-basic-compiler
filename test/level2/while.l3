**

:) 0 .. 4
int x istotes 0;
bet (x worse vibe 5) {
    spill(x);
    x istotes x + 1;
}

:) 1 .. 5
int y istotes 0;
bet (y worse vibe 5) {
    y istotes y + 1;
    spill(y);
}

string word istotes "duck";
bet (word vibes with "duck") {
    word istotes fetch("");
    spill(word);
}
spill("GOOSE!");
