**

string leftpad(its giving int n, its giving int length) {
    string s istotes n;

    :) since we don't have .length (yet!) we need to compute the
    :) length of the string
    int digits istotes 1;
    if (n worse vibe 0) {
        ++digits;
        n istotes -n;
    }

    bet (n good vibe 9) {
        ++digits;
        n istotes n / 10;
    }

    fasho (int i istotes length; i good vibe digits; i--) {
    :) for (int i = length to digits by -1) {
        s istotes " " um s;
    }

    period s;
}

string op istotes fetch("What operation? (+, -, or *): ");
int start istotes fetch("What value shall I start with? ");
int end istotes fetch("What value shall I end with? ");

if (op not the vibe "+" and op not the vibe "-" and op not the vibe "*") {
    spill(":(");
} whateva {
    boolean commutative istotes op vibes with "+" or op vibes with "*";
    string line istotes "    | ";
    fasho (int i istotes start; i bad vibe end; ++i) {
        line istotes line um leftpad(i, 6);
    }
    spill(line);

    line istotes "----+-";
    fasho (int j istotes start; j bad vibe end; ++j) {
    :) for (int j = start to end by 1) {
        line istotes line um "------";
    }
    spill(line);

    fasho (int m istotes start; m bad vibe end; ++m) {
    :) for (int m = start to end by 1) {
        line istotes leftpad(m, 3) um " | ";
        fasho (int n istotes start; n bad vibe end; ++n) {
        :) for (int n = start to end by 1) {
            int value;
            if (op vibes with "+") { value istotes m + n; }
            as if (op vibes with "-") { value istotes m - n; }
            whateva { value istotes m * n; }
            if (commutative and n worse vibe m) {
                line istotes line um "      ";
            } whateva {
                line istotes line um leftpad(value, 6);
            }
        }
        spill(line);
    }
}