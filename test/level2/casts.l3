/* casts.l3: explicit typecasts
   (This test file is optional - explicit typecasts are not required at level 2.)
[[BEGIN TEST CASES]]
Output: <<35
35.0
35
9
9.81
9.81
35
9.81
cheese
true
true
true
1.8
12
100
67>>
[[END TEST CASES]]
*/

print((int)35);             // 35
print((double)35);          // 35.0
print((string)35);          // 35

print((int)9.81);           // 9
print((double)9.81);        // 9.81
print((string)9.81);        // 9.81

print((int)"35");           // 35
print((double)"9.81");      // 9.81
print((string)"cheese");    // cheese

print((boolean)true);       // true
print((boolean)"true");     // true
print((string)true);        // true

print((double)9/5);         // 1.8
print((string)1+2);         // 12
print(50*(int)2.5);         // 100
print(6+(string)7);         // 67
