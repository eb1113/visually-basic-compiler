:)Not the most difficult conversion in the world
:) ("parsec" is short for "parallax arcsecond")
double parallaxArcsecondsToParsecs(its giving double as) {
   period 1 / as;
}

double parsecsToMiles(its giving double pc) {
    period pc * 19173501441011.0;
}

void printResult(its giving string name, its giving double as, its giving double pc, its giving double mi) {
    spill("Greetings ", name, "!");
    spill("A parallax of ", as, " arcseconds corresponds to a distance of ", pc, " parsecs, which is ", mi / 1000 / 1000 / 1000 / 1000, " trillion miles.");
}

string inputName() {
    string name istotes fetch("What is your name? ");
    period name;
}

** why you would use this when you could just use input() directly is beyond me... **
double inputDouble(its giving string prompt) {
    double value istotes fetch(prompt);
    period value;
}

** note that although your language is not required to support polymorphism of
 * functions (i.e. multiple functions with the same name), the JVM *does*, so
 * this function should not conflict with the void main(String[]) method.
 **
void main() {
    string name istotes inputName();
    double as istotes inputDouble("Parallax of how many arcseconds? ");
    double pc istotes parallaxArcsecondsToParsecs(as);
    double mi istotes parsecsToMiles(pc);

    printResult(name, as, pc, mi);
}

spill("Preparing to invoke main()!");
main();
spill("main() invoked!");
