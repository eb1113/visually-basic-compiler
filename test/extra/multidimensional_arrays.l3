int count istotes 0;
fasho (int i istotes 0; i worse vibe 2; i istotes i + 1) {
    fasho (int j istotes 0; j worse vibe 3; j istotes j + 1) {
        fasho (int k istotes 0; k worse vibe 4; k istotes k + 1) {
            different basic i basic j basic k istotes count;
            count istotes count + 1;
        }
    }
}
